export type CategoryType = 'personal' | 'financiero' | 'operativo';

export interface User {
  id: string;
  name: string;
  avatar: string;
  color: string;
  role: 'partner_a' | 'partner_b';
  points: number;
}

export interface Habit {
  id: string;
  name: string;
  category: CategoryType;
  ownerId: string; // User ID
  frequency: string;
  streak: number;
  history: { [date: string]: boolean }; // Map of 'yyyy-mm-dd' -> completed
  cue: string; // Atomic Habit: "Señal"
  craving: string; // "Anhelo"
  response: string; // "Respuesta" (the habit action itself, made easy)
  reward: string; // "Recompensa" (immediate satisfaction)
  difficulty: 'fácil' | 'medio' | 'difícil';
  createdAt: string;
}

export interface Reward {
  id: string;
  title: string;
  description: string;
  proposerId: string; // Who proposed it
  claimerId?: string; // Who can claim it (or who claimed it)
  state: 'propuesta' | 'reclamada' | 'disponible' | 'completada';
  category: 'personal' | 'financiero' | 'operativo' | 'experiencia';
  pointsCost: number; // Habits checked add points
  rewardValue: string; // "Te invito a cenar", "Libre de lavar platos por 3 días"
}

export interface Message {
  id: string;
  senderId: string;
  text: string;
  timestamp: string;
  emoji?: string;
  isSystem?: boolean;
}

export interface TechnicalModule {
  id: string;
  title: string;
  icon: string;
  description: string;
  details: string[];
}

export interface DataEntity {
  name: string;
  description: string;
  fields: { name: string; type: string; desc: string; isKey?: boolean; isFK?: boolean }[];
  relationships: string[];
}

export interface UserFlowStep {
  step: number;
  phase: string;
  title: string;
  action: string;
  atomicHabitPrinciple: string;
}
